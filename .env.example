# ── EcoSetu AI Master Environment Configuration Template ───────────────────────

# Backend Server Settings
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ENABLE_DEMO_AUTH=false

# Firebase Admin Service Account Credentials (For server-side token verification)
FIREBASE_PROJECT_ID=ecosetu-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@ecosetu-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Gemini API Key (For Grounded GenAI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Python FastAPI ML Microservice URL & Origins
ML_SERVICE_URL=http://127.0.0.1:8000
ML_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# Frontend Web Application Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=ecosetu-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ecosetu-ai
VITE_FIREBASE_STORAGE_BUCKET=ecosetu-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_ENABLE_DEMO_MODE=false
