# ── EcoSetu AI Environment Configuration ─────────────────────────────────────

# Express Backend Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
ML_SERVICE_URL=http://127.0.0.1:8000

# Google Gemini API Key (for LLM Assistant & Contextual Explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Python FastAPI ML Microservice Configuration
ML_PORT=8000
HOST=0.0.0.0

# Frontend Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=ecosetu-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ecosetu-ai
VITE_FIREBASE_STORAGE_BUCKET=ecosetu-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Backend & ML Service URLs
VITE_BACKEND_URL=http://localhost:3001
VITE_ML_SERVICE_URL=http://127.0.0.1:8000
