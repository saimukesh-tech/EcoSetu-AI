rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Events ─────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.organizerUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource.data.organizerUid == request.auth.uid || isAdmin()
      );
    }

    // ── Waste Predictions ──────────────────────────────────────────────────
    match /waste_predictions/{predId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // ── Recovery Partners ──────────────────────────────────────────────────
    match /recovery_partners/{partnerId} {
      // Public partner discovery
      allow read: if isAuthenticated();
      allow write: if isOwner(partnerId) || isAdmin();
      
      // Private verification documents subcollection
      match /private_documents/{docId} {
        allow read, write: if isOwner(partnerId) || isAdmin();
      }
    }

    // ── Pickup Requests ────────────────────────────────────────────────────
    match /pickup_requests/{reqId} {
      allow create: if isAuthenticated() && request.resource.data.organizerUid == request.auth.uid;
      allow read, update: if isAuthenticated() && (
        resource.data.organizerUid == request.auth.uid ||
        resource.data.partnerUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.organizerUid == request.auth.uid || isAdmin()
      );
    }

    // ── Pickup Status History (Immutable Server/Authorized Operator Audit Trail) ──
    match /pickup_status_history/{histId} {
      allow create: if isAuthenticated() && (
        request.resource.data.changedBy == request.auth.uid || isAdmin()
      );
      allow read: if isAuthenticated();
    }

    // ── Impact Records ─────────────────────────────────────────────────────
    match /impact_records/{recId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // ── Chat Sessions ──────────────────────────────────────────────────────
    match /chat_sessions/{sessionId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // ── Chat Messages ──────────────────────────────────────────────────────
    match /chat_messages/{msgId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }
  }
}
